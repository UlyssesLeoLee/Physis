# Ensure all text files use LF internally; checkout as-is for Markdown / source
# (Windows users will get LF; macOS / Linux users see LF)

# Markdown
*.md text eol=lf

# Rust source
*.rs text eol=lf

# TOML
*.toml text eol=lf

# Shell scripts
*.sh text eol=lf
*.bash text eol=lf

# YAML (CI, etc.)
*.yml text eol=lf
*.yaml text eol=lf

# Markdown tables of contents
docs/**/README.md text eol=lf

# Binary / lockfiles (don't try to diff)
/Cargo.lock -text merge=binary
/target/** -text merge=binary
